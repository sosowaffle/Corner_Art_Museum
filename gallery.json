<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#11100f">
<meta name="description" content="코너의 미술관 — 세 작가와 여섯 전시관의 디지털 아카이브">
<title>코너의 미술관 | Digital Exhibition</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#11100f;--panel:#1b1a18;--soft:#25231f;--paper:#ece8df;--muted:#a6a096;--line:#38352f;--accent:#bbd19a;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans','Noto Sans KR',sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--paper);font:400 14px/1.55 var(--sans);-webkit-font-smoothing:antialiased}button,input,select{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}[hidden]{display:none!important}::selection{background:var(--accent);color:#111}
.shell{max-width:1500px;margin:auto;padding-inline:clamp(20px,5.4vw,85px)}.top{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.16em;font-size:15px;display:flex;align-items:center;gap:13px}.brandmark{border:1px solid #ddd7cc;width:36px;height:36px;display:grid;place-items:center;font:25px var(--serif)}.nav{display:flex;gap:26px}.nav a{font-size:11px;letter-spacing:.13em;color:#cbc6be}.nav a:hover{color:var(--accent)}.tag{font-size:10px;letter-spacing:.16em;color:var(--accent)}.hero{padding:86px 0 51px;display:grid;grid-template-columns:1.4fr .6fr;gap:30px;align-items:end}.hero h1{font:400 clamp(56px,8vw,118px)/.96 var(--serif);letter-spacing:-.055em;margin:15px 0 0}.hero h1 em{font-weight:400;color:var(--accent)}.hero p{font-size:13px;line-height:2.1;color:#bbb5ac;max-width:360px;margin:0 0 20px auto;word-break:keep-all}.hero-facts{display:flex;justify-content:flex-end;gap:30px}.hero-facts strong{font:36px var(--serif);display:block}.hero-facts small{font-size:10px;color:var(--muted);letter-spacing:.15em}.strip{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:17px 0;font-size:10px;letter-spacing:.15em;color:var(--muted)}
section{scroll-margin-top:30px}.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin:86px 0 27px}.section-no{color:var(--accent);letter-spacing:.19em;font-size:10px;margin-bottom:12px}.section-head h2{font:400 clamp(36px,4.2vw,56px)/1.1 var(--serif);margin:0}.section-head p{font-size:12px;color:var(--muted);margin:11px 0 0}.arrows{display:flex;gap:9px;align-items:center}.round{width:43px;height:43px;border:1px solid #605b52;background:transparent;color:var(--paper);border-radius:50%;font-size:21px}.round:hover{background:var(--paper);color:var(--bg)}.counter{font-size:11px;color:var(--muted);margin-right:12px;letter-spacing:.12em}
.featured{display:flex;gap:22px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;padding-bottom:16px;scrollbar-width:thin;scrollbar-color:#534d43 transparent}.feature{flex:0 0 min(420px,80vw);scroll-snap-align:start;cursor:pointer;min-width:0}.frame{background:#211f1c;display:grid;place-items:center;position:relative;overflow:hidden}.feature .frame{height:clamp(310px,35vw,450px)}.frame img{width:100%;height:100%;object-fit:contain}.frame video{width:100%;height:100%;object-fit:contain;pointer-events:none}.media-type{position:absolute;right:12px;top:12px;background:#111d;color:white;padding:7px 10px;font-size:10px;letter-spacing:.1em}.art-caption{display:flex;justify-content:space-between;gap:15px;margin-top:14px}.art-caption b{font-size:14px;font-weight:500;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:330px}.art-caption small{font-size:11px;color:var(--muted);display:block;margin-top:4px}.feature:hover .frame,.tile:hover .frame{outline:1px solid var(--accent);outline-offset:-1px}
.halls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.hall{background:#1b1a17;border:1px solid var(--line);min-height:245px;text-align:left;color:var(--paper);padding:25px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;transition:border-color .2s}.hall:hover{border-color:var(--accent)}.hall .hall-num{color:var(--accent);font-size:10px;letter-spacing:.2em}.hall .hall-title{font-size:20px;font-weight:500}.hall .hall-desc{font-size:11px;color:var(--muted);margin-top:7px}.hall .hall-count{font:38px var(--serif);color:#6e6b61}.hall .enter{font-size:11px;letter-spacing:.1em;color:var(--accent)}
.artists{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.artist{border:1px solid var(--line);color:var(--paper);background:#1c1a18;padding:25px 22px;display:flex;gap:17px;align-items:center;text-align:left;transition:border-color .2s}.artist:hover{border-color:var(--accent)}.heart{background:#34312d;width:62px;height:62px;display:grid;place-items:center;font-size:30px;flex:none}.artist-name{font-weight:600;font-size:17px}.artist small{color:var(--muted);display:block;font-size:11px;margin-top:5px}.artist .forward{color:var(--accent);font-size:20px;margin-left:auto}
.collection-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:15px;align-items:center}.tools{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.search,.select{border:1px solid var(--line);background:var(--panel);color:var(--paper);padding:12px 14px;font-size:12px;min-height:43px}.search{width:min(330px,80vw)}.select{max-width:200px}.chips{display:flex;gap:8px;flex-wrap:wrap;margin:26px 0 22px}.chip{background:transparent;border:1px solid var(--line);color:var(--muted);padding:9px 13px;font-size:11px;border-radius:30px}.chip[aria-pressed=true],.chip:hover{color:#141612;background:var(--accent);border-color:var(--accent)}.active-note{padding:15px 0;color:var(--muted);font-size:12px;display:flex;align-items:center;justify-content:space-between;gap:15px}.clear{color:var(--accent);background:none;border:0;text-decoration:underline;text-underline-offset:5px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:27px 17px}.tile{min-width:0;cursor:pointer}.tile .frame{height:clamp(185px,21vw,300px)}.tile b{font-weight:500;font-size:13px;display:block;margin-top:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tile small{font-size:11px;color:var(--muted);display:block;margin-top:4px}.empty{border:1px solid var(--line);padding:60px 20px;text-align:center;color:var(--muted);grid-column:1/-1}.more-wrap{display:flex;justify-content:center;margin:38px 0}.more{background:transparent;border:1px solid #756f64;color:var(--paper);padding:14px 38px;letter-spacing:.12em;font-size:11px}.more:hover{background:var(--paper);color:var(--bg)}.about{border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:90px 0 70px;padding:36px 0;display:flex;justify-content:space-between;align-items:center;gap:20px}.about h3{font:36px var(--serif);margin:0 0 12px}.about p{color:var(--muted);font-size:12px;line-height:1.9}.about span{color:var(--accent);font-size:11px;letter-spacing:.12em}footer{padding-bottom:44px;color:#8c867d;font-size:10px;letter-spacing:.1em;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
.viewer{position:fixed;inset:0;background:#0b0b0bf8;z-index:99;display:none;align-items:center;justify-content:center;padding:66px 30px 35px}.viewer.open{display:flex}.viewer-close{position:absolute;top:19px;right:28px;background:none;border:0;color:white;font-size:31px}.viewer-layout{width:min(1400px,100%);display:grid;grid-template-columns:minmax(0,1.85fr) minmax(250px,.65fr);align-items:center;gap:35px;max-height:100%}.viewer-media{height:min(78vh,850px);display:grid;place-items:center;min-width:0}.viewer-media img{width:100%;height:100%;object-fit:contain}.viewer-media video{max-width:100%;max-height:100%;width:100%;background:#050505}.viewer-info{max-height:75vh;overflow-y:auto}.viewer-info h2{font:400 clamp(26px,3vw,43px)/1.2 var(--serif);overflow-wrap:anywhere}.viewer-info p{color:#bdb7ad;font-size:12px;line-height:1.9;white-space:pre-wrap}.viewer-info .credit{color:var(--accent);font-size:13px}.viewer-buttons{display:flex;gap:10px;margin-top:28px;flex-wrap:wrap}.viewer-buttons button{border:1px solid #676157;color:white;background:none;padding:11px 18px}.viewer-buttons button:hover{border-color:var(--accent);color:var(--accent)}.viewer-progress{font-size:11px;color:var(--muted);margin:20px 0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(max-width:960px){.halls{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:repeat(3,1fr)}.hero{grid-template-columns:1fr}.hero p{margin-left:0}.hero-facts{justify-content:flex-start}.artists{grid-template-columns:1fr}.viewer-layout{grid-template-columns:1fr;gap:8px;overflow-y:auto}.viewer-media{height:55vh}.viewer-info{max-height:none}.viewer-info h2{margin:12px 0}}
@media(max-width:620px){.top{min-height:70px;flex-wrap:wrap;padding-block:15px}.brand{font-size:12px}.nav{gap:12px}.nav a{font-size:9px}.hero{padding:54px 0 35px}.hero h1{font-size:clamp(55px,13.5vw,82px)}.hero-facts strong{font-size:28px}.section-head{margin-top:64px}.halls{grid-template-columns:1fr}.hall{min-height:155px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px}.tile .frame{height:210px}.feature .frame{height:350px}.viewer{padding:55px 13px 20px}.viewer-media{height:48vh}.viewer-layout{align-content:start}.about{display:block}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<header class="shell top"><a class="brand" href="#top"><span class="brandmark">A</span> ATELIER / MUSEUM</a><nav class="nav"><a href="#featured-section">EXHIBITION</a><a href="#hall-section">HALLS</a><a href="#artist-section">ARTISTS</a><a href="#collection-section">COLLECTION</a></nav></header>
<main class="shell" id="top">
<section class="hero"><div><div class="tag">DIGITAL ART ARCHIVE · EST. 2026</div><h1>Art belongs<br><em>on the wall.</em></h1></div><div><p>세 작가의 시선과 여섯 개의 전시 공간.<br>디스코드에 남겨진 그림과 영상을 한 편의 전시처럼 천천히 감상해 보세요.</p><div class="hero-facts"><div><strong id="total">—</strong><small>ARTWORKS</small></div><div><strong>06</strong><small>EXHIBITION HALLS</small></div><div><strong>03</strong><small>CREATORS</small></div></div></div></section>
<div class="strip"><span>THE CORNER ART MUSEUM</span><span id="updated">LOADING COLLECTION</span><span>SCROLL TO EXPLORE ↓</span></div>
<section id="featured-section"><div class="section-head"><div><div class="section-no">01 / SELECTED ARTWORKS</div><h2>On the wall.</h2><p>작품을 좌우로 넘기고 클릭하여 크게 감상해 보세요.</p></div><div class="arrows"><span class="counter" id="slide-count">—</span><button class="round" id="slide-prev" aria-label="이전 작품">←</button><button class="round" id="slide-next" aria-label="다음 작품">→</button></div></div><div class="featured" id="featured" aria-label="작품 가로 슬라이드"></div></section>
<section id="hall-section"><div class="section-head"><div><div class="section-no">02 / EXHIBITION HALLS</div><h2>Six galleries.</h2><p>채널별로 구성된 전시 공간에 입장해 보세요.</p></div></div><div class="halls" id="halls"></div></section>
<section id="artist-section"><div class="section-head"><div><div class="section-no">03 / THE CREATORS</div><h2>Behind the canvas.</h2><p>작가가 올린 작품을 어느 채널에 있든 한곳에서 감상할 수 있어요.</p></div></div><div class="artists" id="artists"></div></section>
<section id="collection-section"><div class="section-head"><div><div class="section-no">04 / COMPLETE ARCHIVE</div><h2 id="collection-heading">The collection.</h2><p id="collection-caption">모든 작품을 한곳에서 살펴보세요.</p></div><span class="counter" id="result-count"></span></div><div class="collection-top"><div class="tools"><label><span class="sr-only">작품 검색</span><input id="search" class="search" type="search" placeholder="작품명 · 작가 · 설명 검색"></label><label><span class="sr-only">정렬 방식</span><select id="sort" class="select"><option value="new">최신 작품순</option><option value="old">오래된 작품순</option><option value="random">무작위 감상</option></select></label></div><button id="reset" class="clear" hidden>↶ 전체 전시로 돌아가기</button></div><div class="chips" id="chips"></div><div id="active-note" class="active-note"></div><div class="grid" id="grid"></div><div class="more-wrap"><button class="more" id="more" hidden>LOAD MORE ARTWORKS ↓</button></div></section>
<aside class="about"><div><h3>Every work has a story.</h3><p>디스코드의 지정 전시 채널에 등록된 작품은 자동으로 갤러리에 추가됩니다.<br>작품의 권리는 각 원작자에게 있으며, 게시자 정보는 업로드 기준으로 표시됩니다.</p></div><span>COMMUNITY ART ARCHIVE / 2026</span></aside>
</main><footer class="shell"><span>© <span id="year"></span> ATELIER / CORNER ART MUSEUM</span><span>MADE TO BE SEEN.</span></footer>
<div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="작품 상세 감상" aria-hidden="true"><button class="viewer-close" id="close" aria-label="닫기">×</button><div class="viewer-layout"><div class="viewer-media"><img id="large-image" alt=""><video id="large-video" controls playsinline preload="metadata" hidden></video></div><div class="viewer-info"><div class="tag" id="detail-hall"></div><h2 id="detail-title"></h2><div class="credit" id="detail-artist"></div><p id="detail-description"></p><div class="counter" id="detail-date"></div><div class="viewer-progress" id="detail-counter"></div><div class="viewer-buttons"><button id="detail-prev">← PREV</button><button id="detail-next">NEXT →</button></div></div></div></div>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id);
const HALLS=[['corner-art','코너의 미술관','ILLUSTRATION ARCHIVE'],['corner-war','코너의 전쟁기념관','MEMORIAL COLLECTION'],['corner-hehe','코너의 으흐흐관','SPECIAL EXHIBITION'],['to-sosowaffle','to-소소와플','DEDICATED COLLECTION'],['to-corner','to-심심한코너','DEDICATED COLLECTION'],['to-gangsi','to-강시','DEDICATED COLLECTION']];
const ARTISTS=[{id:'corner',name:'심심한 코너',symbol:'🖤',user:'397722270891769858'},{id:'sosowaffle',name:'소소와플',symbol:'🧡',user:'664976847402172417'},{id:'gangsi',name:'강시',symbol:'💙',user:'444120879526445066'}];
const users=Object.fromEntries(ARTISTS.map(p=>[p.user,p]));const hallNames=Object.fromEntries(HALLS.map(h=>[h[0],h[1]]));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeMedia=v=>typeof v==='string'&&/^assets\/artworks\/[a-zA-Z0-9_.-]+\.(png|jpg|jpeg|webp|gif|mp4|webm)$/i.test(v)?v:'';
const source=a=>safeMedia(a.media||a.image);const video=a=>a.mediaType==='video'||/\.(mp4|webm)$/i.test(source(a));
const owner=a=>users[String(a.uploaderId||'')]||ARTISTS.find(p=>p.id===a.authorId)||null;
const author=a=>owner(a)?.name||a.authorName||a.uploaderName||'알 수 없는 게시자';
const date=s=>{let d=new Date(s);return isNaN(d.getTime())?'':d.toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'});};
let all=[],visible=[],mode='all',selection='',kind='all',search='',sort='new',limit=24,focusList=[],focusIndex=0,lastFocus=null,slidex=0;
const title=a=>{const t=(a.title||'').trim();return t&&t!=='image0'&&t!=='image'&&!/^[a-f0-9_-]{20,}$/i.test(t)?t:'제목 없는 작품';};
function thumb(a){const url=esc(source(a)),t=esc(title(a));return video(a)?`<video src="${url}#t=0.1" muted playsinline preload="none" aria-label="${t}"></video><span class="media-type">▶ VIDEO</span>`:`<img src="${url}" alt="${t}" loading="lazy" decoding="async">`;}
function card(a,i,large=false){return `<article class="${large?'feature':'tile'}" data-id="${esc(a.id)}" tabindex="0" role="button" aria-label="${esc(title(a))} 감상"><div class="frame">${thumb(a)}</div>${large?`<div class="art-caption"><div style="min-width:0"><b>${esc(title(a))}</b><small>${esc(author(a))} · ${esc(hallNames[a.category]||a.channelName||'전시 작품')}</small></div><small>${String(i+1).padStart(2,'0')}</small></div>`:`<b>${esc(title(a))}</b><small>${esc(author(a))} · ${esc(hallNames[a.category]||a.channelName||'')}</small>`}</article>`;}
function renderHalls(){$('halls').innerHTML=HALLS.map((h,i)=>{const count=all.filter(a=>a.category===h[0]).length;return `<button class="hall" data-hall="${h[0]}"><div><div class="hall-num">HALL ${String(i+1).padStart(2,'0')} / 06</div><div style="margin-top:28px"><div class="hall-title">${esc(h[1])}</div><div class="hall-desc">${h[2]}</div></div></div><div style="display:flex;justify-content:space-between;align-items:end"><span class="hall-count">${count}</span><span class="enter">ENTER HALL ↗</span></div></button>`;}).join('');}
function renderArtists(){$('artists').innerHTML=ARTISTS.map(p=>{const count=all.filter(a=>owner(a)?.id===p.id).length;return `<button class="artist" data-artist="${p.id}"><span class="heart" aria-hidden="true">${p.symbol}</span><span style="min-width:0"><span class="artist-name">${esc(p.name)}</span><small>${count} ARTWORKS · VIEW ROOM</small></span><span class="forward">↗</span></button>`;}).join('');}
function filterList(){search=$('search').value.trim().toLocaleLowerCase();sort=$('sort').value;let list=all.filter(a=>(mode==='all'||(mode==='hall'&&a.category===selection)||(mode==='artist'&&owner(a)?.id===selection))&&(kind==='all'||(kind==='video'?video(a):!video(a)))&&(!search||[title(a),author(a),a.description,a.channelName,a.uploaderName].some(x=>String(x||'').toLocaleLowerCase().includes(search))));if(sort==='old')list.sort((a,b)=>String(a.createdAt).localeCompare(String(b.createdAt)));if(sort==='random')list.sort((a,b)=>hash(a.id)-hash(b.id));return list;}
function hash(s){let h=2166136261;for(const c of String(s)){h=Math.imul(h^c.charCodeAt(0),16777619)}return h>>>0;}
function renderCollection(resetLimit=true){if(resetLimit)limit=24;visible=filterList();const name=mode==='hall'?hallNames[selection]:mode==='artist'?ARTISTS.find(p=>p.id===selection)?.name:null;$('collection-heading').textContent=name||'The collection.';$('collection-caption').textContent=mode==='hall'?'지정 채널에 등록된 작품 전시':mode==='artist'?'이 작가가 업로드한 작품을 채널 구분 없이 감상합니다.':'모든 작품을 한곳에서 살펴보세요.';$('reset').hidden=mode==='all';$('result-count').textContent=visible.length+' ARTWORKS';$('active-note').innerHTML=`<span>${esc(name||'전체 전시')} · ${visible.length}개 작품</span><span>${esc(kind==='video'?'동영상':kind==='image'?'이미지':'이미지 + 동영상')}</span>`;$('chips').innerHTML=[['all','전체 작품'],['image','이미지'],['video','동영상']].map(x=>`<button class="chip" data-kind="${x[0]}" aria-pressed="${kind===x[0]}">${x[1]}</button>`).join('');renderTiles();}
function renderTiles(){$('grid').innerHTML=visible.length?visible.slice(0,limit).map((a,i)=>card(a,i)).join(''):'<div class="empty">조건에 맞는 작품이 없습니다.<br>다른 전시관이나 필터를 선택해 주세요.</div>';$('more').hidden=limit>=visible.length;$('more').textContent=`LOAD MORE ARTWORKS ↓ (${Math.min(limit,visible.length)} / ${visible.length})`;}
function enter(type,id){mode=type;selection=id;kind='all';$('search').value='';$('sort').value='new';renderCollection();$('collection-section').scrollIntoView({behavior:'smooth'});}
function renderFeatured(){let images=all.filter(a=>!video(a));let candidates=images.length?images:all;let choices=candidates.slice(0,24);$('featured').innerHTML=choices.map((a,i)=>card(a,i,true)).join('')||'<div class="empty">전시 작품을 불러오는 중입니다.</div>';slidex=0;counter();}
function counter(){let cards=[...$('featured').children];if(!cards.length){$('slide-count').textContent='00 / 00';return;}let box=$('featured');let closest=cards.reduce((best,c,i)=>Math.abs(c.offsetLeft-cards[0].offsetLeft-box.scrollLeft)<best.dist?{dist:Math.abs(c.offsetLeft-cards[0].offsetLeft-box.scrollLeft),i}:best,{dist:Infinity,i:0});slidex=closest.i;$('slide-count').textContent=String(slidex+1).padStart(2,'0')+' / '+String(cards.length).padStart(2,'0');}
function slide(n){let cards=$('featured').children;if(!cards.length)return;slidex=Math.max(0,Math.min(cards.length-1,slidex+n));$('featured').scrollTo({left:cards[slidex].offsetLeft-cards[0].offsetLeft,behavior:'smooth'});$('slide-count').textContent=String(slidex+1).padStart(2,'0')+' / '+String(cards.length).padStart(2,'0');}
function displayItem(a){const v=$('large-video'),im=$('large-image');v.pause();v.removeAttribute('src');v.load();im.removeAttribute('src');if(video(a)){im.hidden=true;v.hidden=false;v.src=source(a);v.load();}else{v.hidden=true;im.hidden=false;im.src=source(a);im.alt=title(a);} $('detail-hall').textContent=hallNames[a.category]||a.channelName||'EXHIBITION';$('detail-title').textContent=title(a);$('detail-artist').textContent='ARTIST / UPLOADER — '+author(a);$('detail-description').textContent=(a.description||'')+(a.uploaderName&&a.uploaderName!==author(a)?'\n게시자: '+a.uploaderName:'');$('detail-date').textContent=date(a.createdAt);$('detail-counter').textContent=`${focusIndex+1} / ${focusList.length} ARTWORKS`;
}
function openItem(id,fromFeatured){focusList=fromFeatured?[...$('featured').querySelectorAll('[data-id]')].map(el=>all.find(a=>a.id===el.dataset.id)).filter(Boolean):visible;focusIndex=focusList.findIndex(a=>String(a.id)===id);if(focusIndex<0)return;lastFocus=document.activeElement;displayItem(focusList[focusIndex]);$('viewer').classList.add('open');$('viewer').setAttribute('aria-hidden','false');document.body.style.overflow='hidden';$('close').focus();}
function close(){$('viewer').classList.remove('open');$('viewer').setAttribute('aria-hidden','true');document.body.style.overflow='';$('large-video').pause();$('large-video').removeAttribute('src');$('large-video').load();$('large-image').removeAttribute('src');if(lastFocus?.isConnected)lastFocus.focus();}
function step(n){if(!focusList.length)return;focusIndex=(focusIndex+n+focusList.length)%focusList.length;displayItem(focusList[focusIndex]);}
async function load(){try{const response=await fetch('./gallery.json?t='+Date.now(),{cache:'no-store'});if(!response.ok)throw Error('HTTP '+response.status);const data=await response.json();if(!Array.isArray(data.artworks))throw Error('invalid artwork list');all=data.artworks.filter(a=>source(a)).sort((a,b)=>String(b.createdAt||'').localeCompare(String(a.createdAt||'')));$('total').textContent=all.length.toLocaleString('ko-KR');$('updated').textContent=data.updatedAt?'UPDATED '+date(data.updatedAt):'LIVE COMMUNITY ARCHIVE';renderFeatured();renderHalls();renderArtists();renderCollection();}catch(e){console.error('Gallery load error',e);$('updated').textContent='GALLERY DATA UNAVAILABLE';$('featured').innerHTML='<div class="empty">작품 목록을 불러올 수 없습니다. 잠시 후 새로고침해 주세요.</div>';$('grid').innerHTML='<div class="empty">gallery.json을 확인해 주세요.</div>';}}
$('halls').addEventListener('click',e=>{let b=e.target.closest('[data-hall]');if(b)enter('hall',b.dataset.hall);});$('artists').addEventListener('click',e=>{let b=e.target.closest('[data-artist]');if(b)enter('artist',b.dataset.artist);});$('reset').addEventListener('click',()=>{mode='all';selection='';kind='all';$('search').value='';renderCollection();});$('search').addEventListener('input',()=>renderCollection());$('sort').addEventListener('change',()=>renderCollection());$('chips').addEventListener('click',e=>{let b=e.target.closest('[data-kind]');if(b){kind=b.dataset.kind;renderCollection();}});$('more').addEventListener('click',()=>{limit+=24;renderTiles();});$('slide-prev').addEventListener('click',()=>slide(-1));$('slide-next').addEventListener('click',()=>slide(1));$('featured').addEventListener('scroll',()=>requestAnimationFrame(counter),{passive:true});['featured','grid'].forEach(id=>{const el=$(id);el.addEventListener('click',e=>{let b=e.target.closest('[data-id]');if(b)openItem(b.dataset.id,id==='featured');});el.addEventListener('keydown',e=>{if(['Enter',' '].includes(e.key)){let b=e.target.closest('[data-id]');if(b){e.preventDefault();openItem(b.dataset.id,id==='featured');}}});});$('close').addEventListener('click',close);$('viewer').addEventListener('click',e=>{if(e.target===$('viewer'))close();});$('detail-prev').addEventListener('click',()=>step(-1));$('detail-next').addEventListener('click',()=>step(1));document.addEventListener('keydown',e=>{if(!$('viewer').classList.contains('open'))return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')step(-1);if(e.key==='ArrowRight')step(1);if(e.key==='Tab'){const targets=[...$('viewer').querySelectorAll('button')];if(e.shiftKey&&document.activeElement===targets[0]){e.preventDefault();targets.at(-1).focus()}else if(!e.shiftKey&&document.activeElement===targets.at(-1)){e.preventDefault();targets[0].focus()}}});let startX=null;$('viewer').addEventListener('touchstart',e=>{startX=e.changedTouches[0].clientX},{passive:true});$('viewer').addEventListener('touchend',e=>{if(startX===null)return;const dx=e.changedTouches[0].clientX-startX;if(Math.abs(dx)>75)step(dx<0?1:-1);startX=null},{passive:true});$('year').textContent=new Date().getFullYear();load();
})();
</script>
</body>
</html>
